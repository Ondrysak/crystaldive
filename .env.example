# Copy this file to `.env` and fill in your real keys. `.env` is gitignored.
#
# Materials Project API — get a free key at:
#   https://next-gen.materialsproject.org/api
#
# Used by `fetch_mp.py` to pull crystal structures + (future) bands, DOS,
# phonons, dielectric, magnetism, elasticity, surfaces, XAS, etc.
MP_API_KEY=

# Discord webhook for agent progress reports.
# Create one at: server → Edit Channel → Integrations → Webhooks → New Webhook.
# Used by the SubagentStop hook in .claude/settings.json and by milestone pings
# inside agent prompts. Anyone with this URL can post to the channel — treat
# as a low-stakes secret and rotate from the Discord webhook panel if leaked.
DISCORD_AGENT_WEBHOOK=
